rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isStudentOrTutor() {
      return request.resource.data.keys().hasAll(['role']) &&
        request.resource.data.role in ['student', 'tutor'];
    }

    function validTutorProfile(data) {
      return data.displayName is string && data.displayName.size() <= 60 &&
        data.headline is string && data.headline.size() <= 80 &&
        data.bio is string && data.bio.size() <= 2000 &&
        data.subjects is list && data.subjects.size() <= 8 &&
        data.languages is list && data.languages.size() <= 7 &&
        data.hourlyRate is number &&
        data.hourlyRate >= 0 && data.hourlyRate <= 10000 &&
        (!data.keys().hasAny(['avatarUrl']) || data.avatarUrl == null ||
         (data.avatarUrl is string && data.avatarUrl.size() <= 300));
    }

    function isBookedByTransition(slotBefore, slotAfter, uid) {
      return slotBefore != null &&
        slotAfter != null &&
        (
          (slotBefore.bookedBy == null && slotAfter.bookedBy == uid) ||
          (slotBefore.bookedBy == uid && slotAfter.bookedBy == null)
        );
    }

    function slotEqualExceptBookedBy(a, b) {
      return a != null &&
        b != null &&
        a.id == b.id &&
        a.start == b.start &&
        a.end == b.end &&
        a.lockedBy == b.lockedBy &&
        a.lockExpiresAt == b.lockExpiresAt &&
        a.courseId == b.courseId;
    }

    function slotEqual(a, b) {
      return slotEqualExceptBookedBy(a, b) && a.bookedBy == b.bookedBy;
    }

    function sameSlotCore(a, b) {
      return a != null && b != null &&
        a.id == b.id &&
        a.start == b.start &&
        a.end == b.end &&
        a.courseId == b.courseId;
    }

    function slotUnchanged(a, b) {
      return sameSlotCore(a, b) &&
        a.bookedBy == b.bookedBy &&
        a.lockedBy == b.lockedBy &&
        a.lockExpiresAt == b.lockExpiresAt;
    }

    // Student takes or extends their own hold on a free slot.
    function slotHoldByCaller(a, b, uid) {
      return sameSlotCore(a, b) &&
        a.bookedBy == null &&
        (a.lockedBy == null || a.lockedBy == uid) &&
        b.lockedBy == uid &&
        b.lockExpiresAt != null;
    }

    // Student drops their own hold.
    function slotReleaseByCaller(a, b, uid) {
      return sameSlotCore(a, b) &&
        a.bookedBy == b.bookedBy &&
        a.lockedBy == uid &&
        b.lockedBy == null &&
        b.lockExpiresAt == null;
    }

    // Checkout: hold becomes a booking, lock cleared in the same write.
    function slotClaimAfterHold(a, b, uid) {
      return sameSlotCore(a, b) &&
        a.bookedBy == null && b.bookedBy == uid &&
        a.lockedBy == uid &&
        b.lockedBy == null && b.lockExpiresAt == null;
    }

    // Checkout straight after a selection, no hold involved.
    function slotClaimWithoutHold(a, b, uid) {
      return sameSlotCore(a, b) &&
        a.bookedBy == null && b.bookedBy == uid &&
        a.lockedBy == null && a.lockExpiresAt == null &&
        b.lockedBy == null && b.lockExpiresAt == null;
    }

    // Cancellation: booking released, any leftover lock cleared.
    function slotReleaseOnCancel(a, b, uid) {
      return sameSlotCore(a, b) &&
        a.bookedBy == uid && b.bookedBy == null &&
        b.lockedBy == null && b.lockExpiresAt == null;
    }

    function isLockFieldOnly(slotBefore, slotAfter, uid) {
      return slotBefore == slotAfter ||
        isBookedByTransition(slotBefore, slotAfter, uid);
    }

    function slotAtLockFieldOnly(slotsBefore, slotsAfter, i, uid) {
      return i >= slotsBefore.size() ||
        isLockFieldOnly(slotsBefore[i], slotsAfter[i], uid);
    }

    function slotsLockFieldOnly00to15(slotsBefore, slotsAfter, uid) {
      return slotAtLockFieldOnly(slotsBefore, slotsAfter, 0, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 1, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 2, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 3, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 4, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 5, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 6, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 7, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 8, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 9, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 10, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 11, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 12, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 13, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 14, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 15, uid);
    }

    function slotsLockFieldOnly16to31(slotsBefore, slotsAfter, uid) {
      return slotAtLockFieldOnly(slotsBefore, slotsAfter, 16, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 17, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 18, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 19, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 20, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 21, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 22, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 23, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 24, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 25, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 26, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 27, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 28, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 29, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 30, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 31, uid);
    }

    function slotsLockFieldOnly32to47(slotsBefore, slotsAfter, uid) {
      return slotAtLockFieldOnly(slotsBefore, slotsAfter, 32, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 33, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 34, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 35, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 36, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 37, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 38, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 39, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 40, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 41, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 42, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 43, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 44, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 45, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 46, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 47, uid);
    }

    function slotsLockFieldOnly48to63(slotsBefore, slotsAfter, uid) {
      return slotAtLockFieldOnly(slotsBefore, slotsAfter, 48, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 49, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 50, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 51, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 52, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 53, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 54, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 55, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 56, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 57, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 58, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 59, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 60, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 61, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 62, uid) &&
        slotAtLockFieldOnly(slotsBefore, slotsAfter, 63, uid);
    }

    function slotTransitionAt(slotsBefore, slotsAfter, i, uid) {
      return i < slotsBefore.size() &&
        isBookedByTransition(slotsBefore[i], slotsAfter[i], uid);
    }

    function transitionCount00to15(slotsBefore, slotsAfter, uid) {
      return (slotTransitionAt(slotsBefore, slotsAfter, 0, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 1, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 2, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 3, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 4, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 5, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 6, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 7, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 8, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 9, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 10, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 11, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 12, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 13, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 14, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 15, uid) ? 1 : 0);
    }

    function transitionCount16to31(slotsBefore, slotsAfter, uid) {
      return (slotTransitionAt(slotsBefore, slotsAfter, 16, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 17, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 18, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 19, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 20, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 21, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 22, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 23, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 24, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 25, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 26, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 27, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 28, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 29, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 30, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 31, uid) ? 1 : 0);
    }

    function transitionCount32to47(slotsBefore, slotsAfter, uid) {
      return (slotTransitionAt(slotsBefore, slotsAfter, 32, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 33, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 34, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 35, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 36, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 37, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 38, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 39, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 40, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 41, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 42, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 43, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 44, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 45, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 46, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 47, uid) ? 1 : 0);
    }

    function transitionCount48to63(slotsBefore, slotsAfter, uid) {
      return (slotTransitionAt(slotsBefore, slotsAfter, 48, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 49, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 50, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 51, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 52, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 53, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 54, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 55, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 56, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 57, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 58, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 59, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 60, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 61, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 62, uid) ? 1 : 0) +
        (slotTransitionAt(slotsBefore, slotsAfter, 63, uid) ? 1 : 0);
    }

    function slotClaimDelta(slotBefore, slotAfter, uid) {
      return slotBefore.bookedBy == null && slotAfter.bookedBy == uid ? 1 : 0;
    }

    function slotReleaseDelta(slotBefore, slotAfter, uid) {
      return slotBefore.bookedBy == uid && slotAfter.bookedBy == null ? 1 : 0;
    }

    function slotDelta(slotsBefore, slotsAfter, i, uid) {
      return i < slotsBefore.size()
        ? slotClaimDelta(slotsBefore[i], slotsAfter[i], uid) -
          slotReleaseDelta(slotsBefore[i], slotsAfter[i], uid)
        : 0;
    }

    function deltaSum00to15(slotsBefore, slotsAfter, uid) {
      return slotDelta(slotsBefore, slotsAfter, 0, uid) +
        slotDelta(slotsBefore, slotsAfter, 1, uid) +
        slotDelta(slotsBefore, slotsAfter, 2, uid) +
        slotDelta(slotsBefore, slotsAfter, 3, uid) +
        slotDelta(slotsBefore, slotsAfter, 4, uid) +
        slotDelta(slotsBefore, slotsAfter, 5, uid) +
        slotDelta(slotsBefore, slotsAfter, 6, uid) +
        slotDelta(slotsBefore, slotsAfter, 7, uid) +
        slotDelta(slotsBefore, slotsAfter, 8, uid) +
        slotDelta(slotsBefore, slotsAfter, 9, uid) +
        slotDelta(slotsBefore, slotsAfter, 10, uid) +
        slotDelta(slotsBefore, slotsAfter, 11, uid) +
        slotDelta(slotsBefore, slotsAfter, 12, uid) +
        slotDelta(slotsBefore, slotsAfter, 13, uid) +
        slotDelta(slotsBefore, slotsAfter, 14, uid) +
        slotDelta(slotsBefore, slotsAfter, 15, uid);
    }

    function deltaSum16to31(slotsBefore, slotsAfter, uid) {
      return slotDelta(slotsBefore, slotsAfter, 16, uid) +
        slotDelta(slotsBefore, slotsAfter, 17, uid) +
        slotDelta(slotsBefore, slotsAfter, 18, uid) +
        slotDelta(slotsBefore, slotsAfter, 19, uid) +
        slotDelta(slotsBefore, slotsAfter, 20, uid) +
        slotDelta(slotsBefore, slotsAfter, 21, uid) +
        slotDelta(slotsBefore, slotsAfter, 22, uid) +
        slotDelta(slotsBefore, slotsAfter, 23, uid) +
        slotDelta(slotsBefore, slotsAfter, 24, uid) +
        slotDelta(slotsBefore, slotsAfter, 25, uid) +
        slotDelta(slotsBefore, slotsAfter, 26, uid) +
        slotDelta(slotsBefore, slotsAfter, 27, uid) +
        slotDelta(slotsBefore, slotsAfter, 28, uid) +
        slotDelta(slotsBefore, slotsAfter, 29, uid) +
        slotDelta(slotsBefore, slotsAfter, 30, uid) +
        slotDelta(slotsBefore, slotsAfter, 31, uid);
    }

    function deltaSum32to47(slotsBefore, slotsAfter, uid) {
      return slotDelta(slotsBefore, slotsAfter, 32, uid) +
        slotDelta(slotsBefore, slotsAfter, 33, uid) +
        slotDelta(slotsBefore, slotsAfter, 34, uid) +
        slotDelta(slotsBefore, slotsAfter, 35, uid) +
        slotDelta(slotsBefore, slotsAfter, 36, uid) +
        slotDelta(slotsBefore, slotsAfter, 37, uid) +
        slotDelta(slotsBefore, slotsAfter, 38, uid) +
        slotDelta(slotsBefore, slotsAfter, 39, uid) +
        slotDelta(slotsBefore, slotsAfter, 40, uid) +
        slotDelta(slotsBefore, slotsAfter, 41, uid) +
        slotDelta(slotsBefore, slotsAfter, 42, uid) +
        slotDelta(slotsBefore, slotsAfter, 43, uid) +
        slotDelta(slotsBefore, slotsAfter, 44, uid) +
        slotDelta(slotsBefore, slotsAfter, 45, uid) +
        slotDelta(slotsBefore, slotsAfter, 46, uid) +
        slotDelta(slotsBefore, slotsAfter, 47, uid);
    }

    function deltaSum48to63(slotsBefore, slotsAfter, uid) {
      return slotDelta(slotsBefore, slotsAfter, 48, uid) +
        slotDelta(slotsBefore, slotsAfter, 49, uid) +
        slotDelta(slotsBefore, slotsAfter, 50, uid) +
        slotDelta(slotsBefore, slotsAfter, 51, uid) +
        slotDelta(slotsBefore, slotsAfter, 52, uid) +
        slotDelta(slotsBefore, slotsAfter, 53, uid) +
        slotDelta(slotsBefore, slotsAfter, 54, uid) +
        slotDelta(slotsBefore, slotsAfter, 55, uid) +
        slotDelta(slotsBefore, slotsAfter, 56, uid) +
        slotDelta(slotsBefore, slotsAfter, 57, uid) +
        slotDelta(slotsBefore, slotsAfter, 58, uid) +
        slotDelta(slotsBefore, slotsAfter, 59, uid) +
        slotDelta(slotsBefore, slotsAfter, 60, uid) +
        slotDelta(slotsBefore, slotsAfter, 61, uid) +
        slotDelta(slotsBefore, slotsAfter, 62, uid) +
        slotDelta(slotsBefore, slotsAfter, 63, uid);
    }

    function slotsExactlyOneLockTransition(slotsBefore, slotsAfter, uid) {
      return slotsBefore.size() == slotsAfter.size() &&
        slotsBefore.size() <= 64 &&
        slotsLockFieldOnly00to15(slotsBefore, slotsAfter, uid) &&
        slotsLockFieldOnly16to31(slotsBefore, slotsAfter, uid) &&
        slotsLockFieldOnly32to47(slotsBefore, slotsAfter, uid) &&
        slotsLockFieldOnly48to63(slotsBefore, slotsAfter, uid) &&
        (
          transitionCount00to15(slotsBefore, slotsAfter, uid) +
          transitionCount16to31(slotsBefore, slotsAfter, uid) +
          transitionCount32to47(slotsBefore, slotsAfter, uid) +
          transitionCount48to63(slotsBefore, slotsAfter, uid)
        ) <= 2 &&
        (
          deltaSum00to15(slotsBefore, slotsAfter, uid) +
          deltaSum16to31(slotsBefore, slotsAfter, uid) +
          deltaSum32to47(slotsBefore, slotsAfter, uid) +
          deltaSum48to63(slotsBefore, slotsAfter, uid)
        ) >= -1 &&
        (
          deltaSum00to15(slotsBefore, slotsAfter, uid) +
          deltaSum16to31(slotsBefore, slotsAfter, uid) +
          deltaSum32to47(slotsBefore, slotsAfter, uid) +
          deltaSum48to63(slotsBefore, slotsAfter, uid)
        ) <= 1;
    }

    // Student slot writes: exactly one element changes, either a claim
    // (bookedBy null -> caller) or a release (bookedBy caller -> null).
    // Implemented with list set-difference so the rule costs ~20 expressions
    // instead of a 64-index literal expansion, which exceeded the per-request
    // expression budget and surfaced as "Missing or insufficient permissions".

    function slotCoreSame(before, after) {
      return before.id == after.id &&
        before.start == after.start &&
        before.end == after.end;
    }

    function claimPair(before, after, uid) {
      return slotCoreSame(before, after) &&
        before.bookedBy == null && after.bookedBy == uid &&
        after.lockedBy == before.lockedBy &&
        after.lockExpiresAt == before.lockExpiresAt;
    }

    function releasePair(before, after, uid) {
      return slotCoreSame(before, after) &&
        before.bookedBy == uid && after.bookedBy == null &&
        after.lockedBy == before.lockedBy &&
        after.lockExpiresAt == before.lockExpiresAt;
    }

    function slotsClaimOrRelease(b, a, uid) {
      return a.size() == b.size() && b.size() <= 64 && (
        (a.removeAll(b).size() == 1 && b.removeAll(a).size() == 1 &&
         claimPair(b.removeAll(a)[0], a.removeAll(b)[0], uid)) ||
        (a.removeAll(b).size() == 1 && b.removeAll(a).size() == 1 &&
         releasePair(b.removeAll(a)[0], a.removeAll(b)[0], uid))
      );
    }

    // -------- USERS --------
    // Owner creates with role in ('student','tutor') only; owner cannot
    // mutate role on update. Admin-SDK changes role via Cloud Functions.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isStudentOrTutor();
      allow update: if isOwner(uid) && !('role' in affectedKeys());
      allow delete: if false;
    }

    // -------- TUTORS --------
    // Read: public (student browse)
    // Create: owner only, must start with pending verification + zero rating
    // Update (owner): cannot change uid, verificationStatus, rating, ratingCount
    // Update (non-owner): can only flip bookedBy on one slot via the slots array
    // Delete: disabled
    match /tutors/{uid} {
      allow read: if true;

      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.rating == 0 &&
        request.resource.data.ratingCount == 0 &&
        validTutorProfile(request.resource.data);

      allow update: if isOwner(uid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.verificationStatus == resource.data.verificationStatus &&
        request.resource.data.rating == resource.data.rating &&
        request.resource.data.ratingCount == resource.data.ratingCount &&
        validTutorProfile(request.resource.data);

      allow update: if isSignedIn() &&
        !isOwner(uid) &&
        affectedKeys().hasOnly(['slots']) &&
        slotsClaimOrRelease(resource.data.slots,
                            request.resource.data.slots,
                            request.auth.uid);

      allow delete: if false;
    }

    match /tutor_private/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // -------- BOOKINGS --------
    // Read: parties only
    // Create: student creates own booking, paymentMode must be 'simulated', status 'confirmed'
    // Update (student): cancel before slotEnd with reason/note, or reschedule (slotStart/slotEnd/status→confirmed)
    // Update (tutor): cancel before slotEnd with reason/note, or mark confirmed session complete after slotEnd
    // Delete: disabled
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.tutorId == request.auth.uid
      );

      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.paymentMode == 'simulated' &&
        request.resource.data.status == 'confirmed';

      allow update: if isSignedIn() &&
        resource.data.studentId == request.auth.uid &&
        (
          (resource.data.status in ['pending', 'confirmed'] &&
           request.time < resource.data.slotEnd &&
           affectedKeys().hasOnly(['status', 'cancelledBy',
                                   'cancellationReason', 'cancellationNote',
                                   'cancelledAt']) &&
           request.resource.data.status == 'cancelled' &&
           request.resource.data.cancelledBy == 'student' &&
           request.resource.data.cancellationReason in
             ['schedule_conflict', 'booked_by_mistake', 'found_another_tutor',
              'price', 'other'] &&
           request.resource.data.cancellationNote is string &&
           request.resource.data.cancellationNote.size() <= 200) ||
          (affectedKeys().hasOnly(['slotStart', 'slotEnd', 'status']) &&
           request.resource.data.status == 'confirmed')
        );

      allow update: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid &&
        resource.data.status == 'confirmed' &&
        request.resource.data.status == 'completed' &&
        affectedKeys().hasOnly(['status', 'completedAt']) &&
        request.time >= resource.data.slotEnd;

      allow update: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid &&
        resource.data.status in ['pending', 'confirmed'] &&
        request.time < resource.data.slotEnd &&
        affectedKeys().hasOnly(['status', 'cancelledBy',
                                'cancellationReason', 'cancellationNote',
                                'cancelledAt']) &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.cancelledBy == 'tutor' &&
        request.resource.data.cancellationReason in
          ['emergency', 'schedule_conflict', 'not_my_subject', 'other'] &&
        request.resource.data.cancellationNote is string &&
        request.resource.data.cancellationNote.size() <= 200;

      allow delete: if false;
    }

    // -------- VERIFICATION REQUESTS --------
    // Read: owner only
    // Create: owner only, status must be 'pending', fields whitelisted
    // Update: owner only, status must remain 'pending', only status/idType writable
    // Reviewer fields are Admin-SDK only (via Firebase Console or admin script)
    match /verification_requests/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'recipientEmail', 'subjects', 'languages',
          'headline', 'hourlyRate', 'bio', 'status', 'updatedAt'
        ]);
      allow update: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'recipientEmail', 'subjects', 'languages',
          'headline', 'hourlyRate', 'bio', 'status', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // -------- COURSES --------
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.tutorId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid;
    }

    // -------- MODULES --------
    // Unchanged from current repo rules.
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.tutorId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid;
    }

    // -------- EXAMS --------
    // Unchanged from current repo rules.
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.tutorId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid;
    }

    // -------- ASSIGNMENTS --------
    // Unchanged from current repo rules (already field-whitelisted).
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        resource.data.tutorId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.tutorId == request.auth.uid;
      allow update: if isSignedIn() && (
        (
          resource.data.tutorId == request.auth.uid &&
          affectedKeys().hasOnly(['grade', 'feedback', 'status'])
        ) ||
        (
          resource.data.studentId == request.auth.uid &&
          affectedKeys().hasOnly([
            'submissionUrl', 'submissionText', 'submittedAt', 'status'
          ])
        )
      );
      allow delete: if isSignedIn() &&
        resource.data.tutorId == request.auth.uid;
    }

    // -------- FLASHCARD DECKS --------
    // Unchanged from current repo rules.
    match /flashcard_decks/{deckId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
    }

    // -------- MOCK EXAMS --------
    // Unchanged from current repo rules.
    match /mock_exams/{mockId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
    }
  }
}
